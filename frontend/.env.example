# ==============================================================================
# SCULPX E-BILLING — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env.local for local development or deploy to your VPS.
# WARNING: Never commit real production secrets or private credentials to git.

# ------------------------------------------------------------------------------
# 1–2. Backend Server Base URL
# ------------------------------------------------------------------------------
# Single origin for the backend. The app derives:
#   REST API  -> <BACKEND_URL>/api/v1
#   WebSocket -> <BACKEND_URL>/ws  (ws:// for http, wss:// for https)
# In development: http://localhost:8000
# In production (VPS): https://api.yourdomain.com
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 3. Frontend Canonical Application URL
# ------------------------------------------------------------------------------
# Used for generating table and room QR codes, external redirects, and social tags.
# In development: http://localhost:3000
# In production (VPS): https://pos.yourdomain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 4. Mock Service Switch
# ------------------------------------------------------------------------------
# true  = Frontend runs self-contained mock services using in-memory mock database
# false = Frontend makes live HTTP & WebSocket calls to the backend at NEXT_PUBLIC_BACKEND_URL
NEXT_PUBLIC_USE_MOCK_API=true

# ------------------------------------------------------------------------------
# 5. Localization & Branding Metadata
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="SCULPX E-Billing & Hospitality POS"
NEXT_PUBLIC_CURRENCY_SYMBOL="₹"
NEXT_PUBLIC_CURRENCY_CODE="INR"
