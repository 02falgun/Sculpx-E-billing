# ==============================================================================
# SCULPX E-BILLING — BACKEND ENVIRONMENT VARIABLES (.env.example)
# ==============================================================================
# Copy this file to .env or .env.local in the backend/ directory.
# NEVER commit real credentials to version control.

# Server Configuration
PORT=8000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# CORS Allowed Origins (comma-separated or single URL)
CORS_ORIGIN=http://localhost:3000

# Database Configuration (Supabase PostgreSQL via Prisma)
# Pooled connection string (Transaction mode, typically port 6543 with ?pgbouncer=true)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection string (Session mode, typically port 5432, used for migrations)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"
