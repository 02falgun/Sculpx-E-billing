# ==============================================================================
# SCULPX E-BILLING — BACKEND ENVIRONMENT VARIABLES (.env.example)
# ==============================================================================
# Copy this file to .env or .env.local in the backend/ directory.
# NEVER commit real credentials to version control.

# Server Configuration
PORT=8000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# CORS Allowed Origins (comma-separated or single URL)
CORS_ORIGIN=http://localhost:3000

# Database Configuration (PostgreSQL via Prisma) — single connection URL
# Used by the app and by Prisma migrations
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?connection_limit=3&pool_timeout=30"

